# === Synapse Configuration ===
# API 키는 절대 코드에 하드코딩하지 말 것

# Brave Search API (무료: 월 1,000회)
# 발급: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# Serper.dev (무료: 월 2,500회, 구글 검색 결과)
# 발급: https://serper.dev
SERPER_API_KEY=

# Tavily (무료: 월 1,000회, AI 최적화)
# 발급: https://app.tavily.com
TAVILY_API_KEY=

# Daum (Kakao) 검색 API (무료: 월 3,000,000회)
# 발급: https://developers.kakao.com/
DAUM_API_KEY=

# Naver Search API (무료: 일 25,000회 — 한국어 검색)
# 발급: https://developers.naver.com → 앱 등록 → 검색 API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Exa Search API (무료: 월 1,000회 — AI 에이전트용)
# 발급: https://exa.ai → Dashboard → API Keys
EXA_API_KEY=

# Firecrawl (무료: 월 1,000 크레딧 — 검색 1회당 2크레딧, 약 500회)
# 발급: https://firecrawl.dev → Dashboard → API Keys
# v2 /search 사용, Authorization: Bearer 인증
FIRECRAWL_API_KEY=

# DuckDuckGo — API 키 불필요. SYNAPSE_ENGINES에 "ddg"를 넣으면 활성화된다.
# (duckduckgo-search 라이브러리 사용, CAPTCHA/레이트리밋에 걸릴 수 있음)

# Google Programmable Search (선택, 기본 비활성)
# 발급: https://developers.google.com/custom-search/v1/introduction
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# === Server Settings ===
SYNAPSE_HOST=127.0.0.1
SYNAPSE_PORT=8888
SYNAPSE_MAX_RESULTS=20

# 엔진 기본 타임아웃(초)과 전체 검색 하드 타임아웃(초)
# 엔진별 예외는 orchestrator.py의 ENGINE_TIMEOUTS에서 지정한다
# (tavily 10.0, firecrawl 8.0 — firecrawl은 응답 편차가 커서 8초 필요)
SYNAPSE_ENGINE_TIMEOUT_SECONDS=4
SYNAPSE_SEARCH_HARD_TIMEOUT_SECONDS=8

# === Engine Selection ===
# 쉼표로 구분, 순서는 우선순위. 여기 없는 엔진은 호출되지 않는다.
# 사용 가능: brave, serper, tavily, daum, naver, exa, ddg, firecrawl, google_cse
SYNAPSE_ENGINES=brave,serper,tavily,daum,naver,exa,ddg,firecrawl

# === Multi-Key Rotation (선택) ===
# 콤마로 구분해 2개 이상 넣으면 KeyRing이 키를 순환 사용한다.
# 지정하지 않으면 위의 단일 키를 1개짜리 링으로 쓴다.
# 순환 트리거: 429/432, 그리고 400 본문에 크레딧 소진 단서가 있을 때
# (firecrawl은 401/402/403도 순환 대상)
SERPER_API_KEYS=
BRAVE_API_KEYS=
EXA_API_KEYS=
TAVILY_API_KEYS=
DAUM_API_KEYS=
NAVER_CLIENT_IDS=
FIRECRAWL_API_KEYS=

# === Caching ===
SYNAPSE_CACHE=true
SYNAPSE_CACHE_MAX=100
SYNAPSE_CACHE_TTL=300
SYNAPSE_CACHE_NEWS_TTL=60

# === Health Auto-Disable ===
SYNAPSE_HEALTH_CHECK=true
SYNAPSE_UNHEALTHY_THRESHOLD=5
SYNAPSE_COOLDOWN_SECONDS=120

# === Logging ===
SYNAPSE_LOG_LEVEL=INFO
